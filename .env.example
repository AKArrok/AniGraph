# ── LLM (DeepSeek / OpenAI 兼容协议) ───────────────────────────
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
SIMPLE_LLM_MODEL=deepseek-v4-flash
# auto=优先原生结构化输出 | prompt=不发送 response_format（CC Switch/火山 Agent Plan 推荐）
STRUCTURED_OUTPUT_MODE=auto

# ── Embeddings ────────────────────────────────────────────────────
# 后端: "ark"=火山方舟 Coding Plan (doubao-embedding-vision) | "local"=HuggingFace | "dashscope"=阿里云
EMBEDDING_BACKEND=ark
# Ark Coding Plan Embedding（doubao-embedding-vision, OpenAI 兼容协议）
# 从 https://console.volcengine.com/ark/region:ark+north/china 获取 Coding Plan API Key
ARK_API_KEY=your-ark-coding-plan-api-key
# 兼容专用变量名；设置后优先于 ARK_API_KEY
# ARK_EMBEDDING_API_KEY=your-ark-coding-plan-api-key
ARK_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_EMBEDDING_MODEL=doubao-embedding-vision
ARK_EMBEDDING_DIMENSIONS=1024
# Coding Plan 限流保护
ARK_EMBEDDING_REQUEST_INTERVAL=3.0
ARK_EMBEDDING_MAX_RETRIES=6
ARK_EMBEDDING_MAX_BACKOFF=30
# 本地模型（仅 EMBEDDING_BACKEND=local 时生效）
# LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# LOCAL_EMBEDDING_DEVICE=auto
# DashScope 模型（仅 EMBEDDING_BACKEND=dashscope 时生效）
# DASHSCOPE_API_KEY=your_dashscope_api_key
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4

# ── Vector DB (Pinecone) ──────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=vector

# ── Web Search (Tavily) ───────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key

# ── Observability — LangSmith (optional) ────────────────────────────
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_PROJECT=langgraph-agent
# LANGCHAIN_TRACING_V2=false

# ── Agent Tuning — optional ───────────────────────────────────────
RETRIEVER_K=5
RETRIEVER_FETCH_K=50
PINECONE_SEARCH_TYPE=similarity
HYBRID_DENSE_K=20
HYBRID_SPARSE_K=20
RERANK_TOP_K=10

# ── Short-term Memory ──────────────────────────────────────────
MEMORY_MAX_ROUNDS=5

# ── 动漫识图（trace.moe + VLM fallback）── ────────────────────────
# 识图开关（关闭后图片上传走普通文本流程）
ENABLE_IMAGE_RECOGNITION=true
# trace.moe API（公共免费，无需认证）
TRACE_MOE_API_URL=https://api.trace.moe/search
TRACE_MOE_TIMEOUT=15
# 置信度阈值: 低于此值触发 VLM fallback
IMAGE_CONFIDENCE_THRESHOLD=0.8

# Expert 证据不达标时允许的重规划次数；交互模式默认不重跑整条链路
MAX_REPLANS=0
# CPU 重排延迟较高，默认关闭；有 GPU 或离线评测时可开启
ENABLE_RERANKING=false
# 图片大小上限（MB），超限自动缩放
IMAGE_MAX_SIZE_MB=10
# VLM fallback（OpenAI 兼容协议，如 DashScope qwen-vl-max）
# 留空则禁用 VLM fallback，trace.moe 失败时降级为"识别失败"提示
# VLM_API_KEY=your_vlm_api_key
# VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VLM_MODEL=qwen-vl-max
